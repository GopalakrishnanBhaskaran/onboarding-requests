<Project Sdk="Microsoft.NET.Sdk">
  <!-- SWA managed Functions: C# isolated worker, HTTP trigger only.
       TargetFramework MUST match staticwebapp.config.json platform.apiRuntime (test: InfraConsistencyTests).
       net9.0 again (31 Oct 2026): the first live deploy on dotnet-isolated:10.0 did not start (every call "Backend call
       failure", VERIFIED_FACTS F21). Back to 10.0 once that is solved; .NET 9 support ends 10 Nov 2026. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>PmoReview.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <!-- Paid path only: active when ALLOW_PAID_SERVICES=true and APPLICATIONINSIGHTS_CONNECTION_STRING is set. -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="3.2.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../adapters/PmoReview.Adapters/PmoReview.Adapters.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Include="../../../tools/sample_data/sample-data.json" Link="sample-data.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
