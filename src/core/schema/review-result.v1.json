{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmo-review.sample.invalid/schema/review-result.v1.json",
  "title": "PMO Request Review result v1",
  "description": "Readiness review of an access request. Never an approval. humanReviewRequired is always true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewRunId", "requestRevision", "readiness", "summary", "findings", "mappingAssessment", "clarificationQuestions", "humanReviewRequired", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reviewRunId": { "type": "string", "pattern": "^[A-Za-z0-9_.:\\-]{1,128}$" },
    "requestRevision": { "type": "integer", "minimum": 1 },
    "readiness": { "enum": ["NeedsInformation", "ReadyForHumanReview", "ManualReviewRequired"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "field", "severity", "message", "ruleId", "ruleVersion", "sourceReference"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z_]{2,39}$" },
          "field": { "type": ["string", "null"], "maxLength": 64 },
          "severity": { "enum": ["Info", "Warning", "Blocking"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "ruleId": { "type": ["string", "null"], "maxLength": 128 },
          "ruleVersion": { "type": ["integer", "null"], "minimum": 1 },
          "sourceReference": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    },
    "mappingAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mappingId", "mappingVersion", "explanation"],
      "properties": {
        "status": { "enum": ["Matched", "NotFound", "Ambiguous", "NotApplicable"] },
        "mappingId": { "type": ["string", "null"], "maxLength": 128 },
        "mappingVersion": { "type": ["integer", "null"], "minimum": 1 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "clarificationQuestions": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "humanReviewRequired": { "const": true },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
