<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain, rules, review engine and interfaces. No Azure SDK references allowed here. -->
  <PropertyGroup>
    <RootNamespace>PmoReview.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../schema/review-result.v2.json" LogicalName="review-result.v2.json" />
    <!-- Databricks access by group name (one file for the agent and tools/databricks/aim_setup.sh). -->
    <EmbeddedResource Include="../../../config/databricks-access.json" LogicalName="databricks-access.json" />
  </ItemGroup>
</Project>
