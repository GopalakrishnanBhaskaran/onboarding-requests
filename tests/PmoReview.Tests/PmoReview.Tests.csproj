<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>PmoReview.Tests</RootNamespace>
    <!-- Tests run to completion; cancellation-token plumbing in test code adds noise only. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/core/PmoReview.Core/PmoReview.Core.csproj" />
    <ProjectReference Include="../../src/adapters/PmoReview.Adapters/PmoReview.Adapters.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../tools/sample_data/sample-data.json" Link="sample-data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
